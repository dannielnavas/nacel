#compdef nacel dilix

_nacel() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a subcommands
  subcommands=(
    'menu:Abre el menú interactivo con todas las opciones / Interactive options menu'
    'chat:Canal de conversación interactivo con memoria / Interactive chat channel'
    'ask:Consulta en lenguaje natural para obtener comandos / Natural language query'
    'fix:Diagnostica y repara el comando fallido previo / Diagnose and fix previous command'
    'explain:Explica arquitectura y lógica de código / Explain code and architecture'
    'debug:Depura trazas de error y causa raíz / Debug error traces and root cause'
    'lang:Ver o cambiar idioma activo (es/en) / View or switch active language'
    'model:Ver o cambiar modelo de IA y estado de Ollama / View or switch AI model and Ollama status'
    'hardware:Diagnóstico de hardware y recomendación de modelo / Hardware specs & model info'
    'help:Muestra la lista de todas las opciones / Show all available options'
  )

  _arguments -C \
    '1:subcomando:->subcmd' \
    '*::argumentos:->args' && return 0

  case "$state" in
    subcmd)
      _describe -t subcommands 'subcomandos de nacel' subcommands
      ;;
    args)
      case "$line[1]" in
        explain|debug)
          _files
          ;;
        lang)
          local -a langs
          langs=(
            'es:Español / Spanish'
            'en:Inglés / English'
          )
          _describe -t langs 'idioma' langs
          ;;
        model)
          if (( CURRENT == 3 )); then
            local -a model_actions
            model_actions=(
              'set:Establecer modelo activo (ej: llama3.2:1b, qwen2.5-coder:7b)'
              'recommend:Asistente interactivo guiado según tu hardware'
              'auto:Auto-configurar el modelo óptimo para tu hardware'
              'list:Listar modelos instalados en Ollama y catálogo'
              'status:Ver estado actual del modelo y Ollama'
            )
            _describe -t model_actions 'acción de modelo' model_actions
          elif (( CURRENT == 4 )) && [[ "$words[2]" == "set" || "$words[3]" == "set" ]]; then
            local -a models
            models=(
              'llama3.2:1b:Ultracompacto de Meta (~1.3GB), ágil y certero en errores'
              'qwen2.5-coder:7b:Estándar de oro en precisión de terminal y bash (~4.7GB)'
              'qwen2.5-coder:3b:Respuesta rápida y excelente equilibrio (~2.0GB)'
              'gemma2:2b:Ultraligero de Google, excelente en explicaciones (~1.6GB)'
              'qwen2.5-coder:1.5b:Consumo mínimo para RAM ajustada (~1.0GB)'
              'qwen2.5-coder:14b:Máxima profundidad lógica y arquitectura (~9.0GB)'
            )
            _describe -t models 'modelo de IA' models
          fi
          ;;
        *)
          _message 'consulta o argumento'
          ;;
      esac
      ;;
  esac
}

_nacel "$@"
